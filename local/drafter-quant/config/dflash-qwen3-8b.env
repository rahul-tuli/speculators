# dflash-qwen3-8b.env — DFlash drafter arm for Qwen/Qwen3-8B.
#
# Sourced by every scripts/NN_*.sh (pass --config <file> or, for run_all.sh,
# as the positional argument). Every value can be overridden by exporting the
# same variable before invoking a script — the caller environment wins.

TARGET=${TARGET:-Qwen/Qwen3-8B}
DRAFTER=${DRAFTER:-RedHatAI/Qwen3-8B-speculator.dflash}
METHOD=${METHOD:-dflash}                    # dflash | dspark (vllm --speculative-config method)
SPEC_TOKENS=${SPEC_TOKENS:-7}               # num_speculative_tokens

# MUST match the drafter's aux_hidden_state_layer_ids (the last layer is
# appended automatically by launch_vllm.py --include-last-layer, on by default):
#   dflash-8B: "2 10 18 26 34"    dspark-4B: "1 9 17 25 33"
LAYER_IDS=${LAYER_IDS:-"2 10 18 26 34"}
HIDDEN=${HIDDEN:-4096}                      # target hidden size (4096=8B, 2560=4B)
