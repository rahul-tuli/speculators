# dspark-qwen3.8-27b.env — DSpark drafter arm for Qwen/Qwen3.8-27B.
#
# Sourced by every scripts/NN_*.sh (pass --config <file> or, for run_all.sh,
# as the positional argument). Every value can be overridden by exporting the
# same variable before invoking a script — the caller environment wins.

TARGET=${TARGET:-Qwen/Qwen3.8-27B}
DRAFTER=${DRAFTER:-RedHatAI/Qwen3.8-27B-speculator.dspark}
METHOD=${METHOD:-dspark}                    # dflash | dspark (vllm --speculative-config method)
SPEC_TOKENS=${SPEC_TOKENS:-8}               # num_speculative_tokens (8 from config)

# MUST match the drafter's aux_hidden_state_layer_ids (the last layer 64 is
# appended automatically by launch_vllm.py --include-last-layer, on by default):
LAYER_IDS=${LAYER_IDS:-"4 12 20 28 36 44 52 60"}
HIDDEN=${HIDDEN:-5120}                      # target hidden size (5120 for 27B)
BACKEND=${BACKEND:-fp8}

TP=${TP:-2}
VLLM_EXTRA_ARGS=${VLLM_EXTRA_ARGS:---tensor-parallel-size 2 --max-model-len 4096}
DATA=${DATA:-$WORK_DIR/data/perfectblend_27b_2048/calibration_data.jsonl}
DISK_BUDGET_GB=${DISK_BUDGET_GB:-200}
HF_HOME=${HF_HOME:-/root/.cache/huggingface}
EXTRA_QUANT_FLAGS=${EXTRA_QUANT_FLAGS:---keep-heads-bf16}
